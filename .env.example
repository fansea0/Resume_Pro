# Copy this file to `.env` in the repository root and fill in your own values.
# `.env` is git-ignored; never commit real keys.

# Required. API key of the OpenAI-compatible service you use.
OPENAI_API_KEY=

# Optional. Base URL of the OpenAI-compatible service.
OPENAI_BASE_URL=https://api.minimax.cn/v1

# Optional. Model name.
OPENAI_MODEL=MiniMax-M3.1-Flash-Preview

# Optional. Maximum tokens per response, request timeout and schema retry count.
# AI_MAX_TOKENS=4096
# AI_REQUEST_TIMEOUT=60s
# AI_MAX_RETRIES=1

# Optional. Reasoning effort for reasoning models: low, medium, high, xhigh, max.
# MiniMax-M3.1-Flash defaults to max, which spends the whole token budget on
# hidden thinking and truncates the answer. Use low there.
# AI_REASONING_EFFORT=low

# Optional. Redis for AI interview state (checkpoint store). Interview feature is disabled without it.
# REDIS_ADDR=127.0.0.1:6379
# REDIS_PASSWORD=
# REDIS_DB=0
